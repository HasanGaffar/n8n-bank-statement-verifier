# Local settings for "npm run verify" and "npm run e2e".
#
# Copy this file to .env in the project folder and change the values there.
# .env is ignored by git; never commit it. Every setting is optional.
# Variables already set in your shell or CI take priority over .env.
# These settings are read by the helper scripts only, not by n8n itself.
#
# Paths: use a path relative to the project folder, a full path from your own
# computer, or one starting with ~ (your home folder). This works on macOS,
# Linux and Windows. Spaces need no quotes. If a value contains "#", put it in
# single quotes. Do not use double quotes around Windows paths: "\n" inside them
# becomes a line break.
#
# Do NOT put your Anthropic API key in this file. Enter it in n8n as an
# "Anthropic" credential and select it on the two Claude nodes.

# Address of your running n8n.
N8N_BASE_URL=http://localhost:5678

# Webhook path; requests go to <N8N_BASE_URL>/webhook/<WEBHOOK_PATH>.
WEBHOOK_PATH=verify-statement

# Folder with the sample statements used by "npm run e2e". It must contain the
# project's samples and expected-fault-rows.json.
SAMPLE_DIR=sample-data

# Statement sent by "npm run verify" when no file is given on the command line.
# No default. Example: sample-data/02-altered-amount.csv
STATEMENT_FILE=

# The next three apply to "npm run verify" only. "npm run e2e" does not use them.
# Account holder name, for example: Example Trading Co
ACCOUNT_HOLDER=
# Verification date, for example 2026-11-26. Empty means today (UTC).
AS_OF_DATE=
# true requests the advisory AI review. It sends statement data to Anthropic,
# costs money and needs the n8n credential described above.
AI_REVIEW=false

# Only if you enabled Header Auth on the webhook node. Set both or neither, to
# the same name and value as in that n8n credential. The value is a secret.
WEBHOOK_AUTH_HEADER_NAME=
WEBHOOK_AUTH_HEADER_VALUE=
